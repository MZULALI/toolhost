{
  "name": "toolhost",
  "version": "0.1.0",
  "description": "Let an LLM write its own tools at runtime. Each tool is parsed, versioned in SQLite, and hot-reloaded into an isolated child process.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/tsconfig.json",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "acorn": "^8.15.0"
  },
  "keywords": [
    "llm",
    "agent",
    "tools",
    "tool-use",
    "function-calling",
    "hot-reload",
    "sqlite",
    "anthropic",
    "openai"
  ],
  "author": "Muhammad Zulali <mzulali0@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MZULALI/toolhost.git"
  },
  "bugs": {
    "url": "https://github.com/MZULALI/toolhost/issues"
  },
  "homepage": "https://github.com/MZULALI/toolhost#readme",
  "devDependencies": {
    "@ai-sdk/openai": "^2.0.0",
    "@anthropic-ai/sdk": "^0.70.0",
    "@types/node": "^22.0.0",
    "ai": "^5.0.0",
    "openai": "^6.0.0",
    "typescript": "^5.9.0"
  }
}
